# Change this to a strong SQL Server SA password before starting Docker Compose.
SA_PASSWORD=ChangeThis_Strong_Password_2026!
ORGANISER_INVITE_CODE=ChangeThis_Organiser_Code
# Optional. Required only for Azure Blob image uploads.
AZURE_BLOB_CONNECTION_STRING=
# Optional. Forgot-password emails. Leave SMTP_HOST empty to run in demo mode
# (the reset link is shown on the page instead of being emailed).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@raceday.local
# Set to false once SMTP is configured.
PASSWORD_RESET_SHOW_LINK=true
