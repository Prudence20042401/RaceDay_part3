@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot password"; }
<div class="auth-wrap panel">
    <div class="eyebrow">Locked out?</div>
    <h1 class="section-title mb-2">Forgot your password?</h1>
    <p class="small-muted">Enter the email address you registered with and we will send you a link to choose a new password.</p>
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-success">@Model.Message</div>
        @if (!string.IsNullOrEmpty(Model.ResetLink))
        {
            <div class="alert alert-warning">
                <div class="fw-bold mb-1">Demo mode</div>
                <div class="small mb-2">No email server is configured, so the reset link is shown here instead of being emailed. It is valid for 1 hour and can be used once.</div>
                <a class="btn btn-success btn-sm" href="@Model.ResetLink">Choose a new password</a>
            </div>
        }
    }
    else
    {
        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-4">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <button class="btn btn-success w-100">Send reset link</button>
        </form>
    }
    <p class="mt-3 mb-0 text-center small-muted">Remembered it? <a asp-action="Login">Back to log in</a></p>
</div>
