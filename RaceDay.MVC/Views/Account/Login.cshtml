
@model LoginViewModel
@{ ViewData["Title"] = "Log in"; }
<div class="auth-wrap panel"><div class="eyebrow">Welcome back</div><h1 class="section-title mb-2">Log in to RaceDay</h1><p class="small-muted">Continue your race journey.</p><form asp-action="Login" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email"/></div><div class="mb-2"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="current-password"/></div><div class="mb-4 text-end"><a asp-action="ForgotPassword" class="small">Forgot your password?</a></div><button class="btn btn-success w-100">Log in</button></form><p class="mt-3 mb-0 text-center small-muted">New to RaceDay? <a asp-action="Register">Create an account</a></p></div>
