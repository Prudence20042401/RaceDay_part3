@model RegisterViewModel
@{ ViewData["Title"] = "Register"; }
<div class="auth-wrap panel"><div class="eyebrow">Be part of the movement</div><h1 class="section-title">Create your account</h1><p class="small-muted">Participants can enter events and track results. Organisers can manage events and race-day entries.</p><form asp-action="Register" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control"/></div></div><div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control"/></div><div class="mb-3"><label asp-for="Password" class="form-label">Password (minimum 8 characters)</label><input asp-for="Password" class="form-control" type="password"/></div><div class="mb-3"><label asp-for="Role" class="form-label"></label><select asp-for="Role" class="form-select" id="roleSelect"><option value="Participant">Participant</option><option value="Organiser">Organiser</option></select></div><div id="participantFields" class="mb-3"><label asp-for="DateOfBirth" class="form-label">Date of birth</label><input asp-for="DateOfBirth" type="date" class="form-control"/></div><div id="organiserFields" class="border rounded-3 p-3 mb-3" style="display:none"><div class="fw-bold mb-2">Organiser details</div><div class="mb-2"><label asp-for="OrganisationName" class="form-label"></label><input asp-for="OrganisationName" class="form-control"/></div><div class="mb-2"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control"/></div><div class="mb-2"><label asp-for="InviteCode" class="form-label">Organiser invite code</label><input asp-for="InviteCode" class="form-control"/></div><small class="small-muted">An authorised invite code is required to create an Organiser account.</small></div><button class="btn btn-success w-100">Create account</button></form><p class="mt-3 text-center small-muted">Already registered? <a asp-action="Login">Log in</a></p></div>
@section Scripts { <script>const role=document.getElementById('roleSelect'), p=document.getElementById('participantFields'), o=document.getElementById('organiserFields');function showRole(){const org=role.value==='Organiser';o.style.display=org?'block':'none';p.style.display=org?'none':'block';document.getElementById('DateOfBirth').required=!org;document.getElementById('OrganisationName').required=org;document.getElementById('PhoneNumber').required=org;document.getElementById('InviteCode').required=org;}role.addEventListener('change',showRole);showRole();</script> }
