@model ResetPasswordViewModel
@{ ViewData["Title"] = "Reset password"; }
<div class="auth-wrap panel">
    <div class="eyebrow">Almost there</div>
    <h1 class="section-title mb-2">Choose a new password</h1>
    <p class="small-muted">Pick a new password for your RaceDay account.</p>
    <form asp-action="ResetPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="Token" />
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>
        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
        <button class="btn btn-success w-100">Reset password</button>
    </form>
    <p class="mt-3 mb-0 text-center small-muted"><a asp-action="ForgotPassword">Request a new link</a> · <a asp-action="Login">Back to log in</a></p>
</div>
