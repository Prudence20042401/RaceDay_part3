@model EventDto
@{ ViewData["Title"] = "Create event"; }
<div class="auth-wrap panel"><div class="eyebrow">Organiser tools</div><h1 class="section-title">Create an event</h1><form asp-action="Create" method="post" enctype="multipart/form-data"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div><div class="mb-3"><label asp-for="EventDate" class="form-label">Event date</label><input asp-for="EventDate" type="date" class="form-control"/></div><div class="mb-3"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control"/></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="Distance" class="form-label"></label><input asp-for="Distance" class="form-control" type="number" step="0.1"/></div><div class="col-md-6 mb-3"><label asp-for="EventType" class="form-label"></label><select asp-for="EventType" class="form-select"><option>Run</option><option>Walk</option><option>Cycle</option></select></div></div><div class="mb-4"><label class="form-label">Event banner (JPG, PNG or WEBP, max 5 MB)</label><input name="banner" type="file" accept="image/png,image/jpeg,image/webp" class="form-control"/></div><button class="btn btn-success">Create event</button> <a asp-controller="Organiser" asp-action="Dashboard" class="btn btn-light">Cancel</a></form></div>
