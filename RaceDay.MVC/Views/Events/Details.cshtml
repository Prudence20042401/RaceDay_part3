@model EventDto
@{ ViewData["Title"] = Model?.Name ?? "Event details"; var categories = ViewBag.Categories as List<CategoryDto> ?? new(); }
@if (Model != null){<div class="event-hero"><partial name="_EventImage" model="Model" /></div>}
<div class="row g-4"><div class="col-lg-8"><a class="small" asp-action="Index">&larr; Back to events</a><div class="eyebrow mt-2">Race details</div><h1 class="section-title">@Model?.Name</h1><p class="lead">@Model?.Description</p><div class="panel mt-4"><div class="row g-3"><div class="col-6"><span class="small-muted">Date</span><div class="fw-bold">@Model?.EventDate?.ToString("dddd, dd MMMM yyyy")</div></div><div class="col-6"><span class="small-muted">Location</span><div class="fw-bold">@Model?.Location</div></div><div class="col-6"><span class="small-muted">Distance</span><div class="fw-bold">@Model?.Distance km</div></div><div class="col-6"><span class="small-muted">Event type</span><div class="fw-bold">@Model?.EventType</div></div></div></div></div>
<div class="col-lg-4"><div class="panel"><h4 class="fw-bold">Available categories</h4>@if (!categories.Any()){<p class="small-muted">No categories have been added yet.</p>}else{<ul class="list-group list-group-flush mb-3">@foreach(var c in categories){<li class="list-group-item px-0"><strong>@c.Name</strong><div class="small-muted">@c.Description</div></li>}</ul>}
@if (Context.Session.GetString("Role") == "Participant" && categories.Any()){<form asp-action="Enter" method="post"><input type="hidden" name="EventID" value="@Model?.EventID"/><label class="form-label" for="CategoryID">Select a category</label><select class="form-select mb-3" name="CategoryID" id="CategoryID">@foreach(var c in categories){<option value="@c.CategoryID">@c.Name</option>}</select><button class="btn btn-success w-100">Enter event</button></form>}else if(Context.Session.GetInt32("UserID") == null){<a class="btn btn-success w-100" asp-controller="Account" asp-action="Login">Log in to enter</a>}else if(Context.Session.GetString("Role") == "Organiser"){<a class="btn btn-outline-success w-100" asp-controller="Organiser" asp-action="AddCategory" asp-route-eventId="@Model?.EventID">Add a category</a>}</div></div></div>
