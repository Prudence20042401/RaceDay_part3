@model EventDto
@{ ViewData["Title"] = "Edit event"; }
<div class="auth-wrap panel"><h1 class="section-title">Edit event</h1><form asp-action="Edit" asp-route-id="@Model.EventID" method="post" enctype="multipart/form-data"><input asp-for="EventID" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div><div class="mb-3"><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" type="date" class="form-control"/></div><div class="mb-3"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control"/></div><div class="row"><div class="col"><label asp-for="Distance" class="form-label"></label><input asp-for="Distance" class="form-control" type="number" step="0.1"/></div><div class="col"><label asp-for="EventType" class="form-label"></label><select asp-for="EventType" class="form-select"><option>Run</option><option>Walk</option><option>Cycle</option></select></div></div><div class="mb-3 mt-3"><label class="form-label">Replace event banner (optional)</label><input name="banner" type="file" accept="image/png,image/jpeg,image/webp" class="form-control"/></div><button class="btn btn-success mt-3">Save changes</button></form></div>
