@model List<EventDto>
@{ ViewData["Title"] = "Organiser dashboard"; }
<div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4"><div><div class="eyebrow">Organiser workspace</div><h1 class="section-title mb-0">Your events</h1><p class="small-muted mb-0">Manage races, categories, entries and results.</p></div><a class="btn btn-success" asp-controller="Events" asp-action="Create">+ Create event</a></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="panel"><div class="small-muted">Events created</div><div class="display-6 fw-bold">@Model.Count</div></div></div><div class="col-md-4"><div class="panel"><div class="small-muted">Total enrolments</div><div class="display-6 fw-bold">@Model.Sum(x=>x.EnrolmentCount)</div></div></div><div class="col-md-4"><div class="panel"><div class="small-muted">Upcoming events</div><div class="display-6 fw-bold">@Model.Count(x=>x.EventDate.HasValue && x.EventDate.Value.Date>=DateTime.Today)</div></div></div></div>
<div class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Distance</th><th>Entries</th><th>Manage</th></tr></thead><tbody>@foreach(var ev in Model){<tr><td><strong>@ev.Name</strong><div class="small-muted">@ev.Location</div></td><td>@ev.EventDate?.ToString("dd MMM yyyy")<div>@if (ev.EventDate.HasValue && ev.EventDate.Value.Date >= DateTime.Today){<span class="pill">Upcoming</span>}else{<span class="pill pill-grey">Completed</span>}</div></td><td>@ev.Distance km · @ev.EventType</td><td>@ev.EnrolmentCount</td><td><div class="d-flex flex-wrap gap-2"><a class="btn btn-sm btn-outline-success" asp-controller="Events" asp-action="Edit" asp-route-id="@ev.EventID">Edit</a><a class="btn btn-sm btn-outline-secondary" asp-action="AddCategory" asp-route-eventId="@ev.EventID">Categories</a><a class="btn btn-sm btn-outline-secondary" asp-action="Enrolments" asp-route-eventId="@ev.EventID">Entries</a><a class="btn btn-sm btn-outline-secondary" asp-action="Results" asp-route-eventId="@ev.EventID">Results</a><form asp-controller="Events" asp-action="Delete" asp-route-id="@ev.EventID" method="post" onsubmit="return confirm('Delete this event?')"><button class="btn btn-sm btn-outline-danger">Delete</button></form></div></td></tr>}</tbody></table></div>@if(!Model.Any()){<div class="text-center py-4"><p class="small-muted">You have not created any events yet.</p><a class="btn btn-success" asp-controller="Events" asp-action="Create">Create your first event</a></div>}</div>
