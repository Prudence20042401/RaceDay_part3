@model List<EnrolmentDto>
@{ ViewData["Title"] = "Event enrolments"; }
<a class="small" asp-action="Dashboard">&larr; Back to dashboard</a><div class="eyebrow mt-2">Organiser workspace</div><h1 class="section-title mb-4">Participant enrolments</h1><div class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>Participant</th><th>Category</th><th>Entered</th><th>Status</th><th>Update status</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.ParticipantName</td><td>@e.CategoryName</td><td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td><td><span class="status status-@e.Status.ToLower()">@e.Status</span></td><td><form asp-action="UpdateStatus" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@e.EnrolmentID"/><input type="hidden" name="eventId" value="@e.EventID"/><select name="status" class="form-select form-select-sm"><option>Pending</option><option>Confirmed</option><option>Cancelled</option></select><button class="btn btn-sm btn-success">Save</button></form></td></tr>}</tbody></table></div>@if(!Model.Any()){<p class="small-muted">No participants have entered this event yet.</p>}</div>
