@model List<EnrolmentDto>
@{ ViewData["Title"] = "Capture results"; }
<a class="small" asp-action="Dashboard">&larr; Back to dashboard</a><div class="eyebrow mt-2">Race-day results</div><h1 class="section-title mb-2">Capture finishing results</h1><p class="small-muted mb-4">Enter a finish time and finishing position for each enrolled participant.</p>
<div class="row g-3">@foreach(var e in Model){<div class="col-lg-6"><div class="panel"><div class="d-flex justify-content-between"><strong>@e.ParticipantName</strong><span class="pill">@e.CategoryName</span></div><form asp-action="RecordResult" method="post" class="row g-2 mt-2"><input type="hidden" name="EnrolmentID" value="@e.EnrolmentID"/><input type="hidden" name="eventId" value="@ViewBag.EventId"/><div class="col-6"><label class="form-label small">Finish time (hh:mm:ss)</label><input name="FinishTime" type="time" step="1" class="form-control" required/></div><div class="col-6"><label class="form-label small">Position</label><input name="FinishingPosition" type="number" min="1" class="form-control" required/></div><div class="col-12"><button class="btn btn-success btn-sm">Save result</button></div></form></div></div>}</div>
@if(!Model.Any()){<div class="panel">No enrolments are available for this event yet.</div>}
