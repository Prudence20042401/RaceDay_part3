@model List<EnrolmentDto>
@{ ViewData["Title"] = "My events"; }
<div class="eyebrow">Participant space</div><h1 class="section-title mb-4">My event entries</h1><div class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Entry status</th><th></th></tr></thead><tbody>@foreach(var e in Model){<tr><td><strong>@e.EventName</strong></td><td>@e.EventDate.ToString("dd MMM yyyy")</td><td>@e.CategoryName</td><td><span class="status status-@e.Status.ToLower()">@e.Status</span></td><td><a class="btn btn-sm btn-outline-success" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventID">View event</a></td></tr>}</tbody></table></div>@if(!Model.Any()){<p class="small-muted">You have not entered an event yet. <a asp-controller="Events" asp-action="Index">Explore events</a>.</p>}</div>
