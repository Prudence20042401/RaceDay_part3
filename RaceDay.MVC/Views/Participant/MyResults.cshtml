@model List<ResultDto>
@{ ViewData["Title"] = "My results"; }
<div class="eyebrow">Your race history</div><h1 class="section-title mb-4">My results</h1><div class="row g-3">@foreach(var r in Model){<div class="col-md-6"><div class="panel"><div class="d-flex justify-content-between align-items-start"><div><h5 class="fw-bold mb-1">@r.EventName</h5><div class="small-muted">@r.EventDate.ToString("dd MMM yyyy") · @r.CategoryName</div></div><span class="pill">Race result</span></div><div class="row mt-3"><div class="col-6"><div class="small-muted">Finish time</div><div class="fs-4 fw-bold">@(r.FinishTime?.ToString("hh\\:mm\\:ss") ?? "—")</div></div><div class="col-6"><div class="small-muted">Finishing position</div><div class="fs-4 fw-bold">@(r.FinishingPosition?.ToString() ?? "—") <small class="fs-6 text-secondary">of @r.TotalFinishers</small></div></div></div></div></div>}</div>@if(!Model.Any()){<div class="panel">Your results will appear here after an Organiser records them for a completed event.<div class="mt-3"><a class="btn btn-success" asp-controller="Events" asp-action="Index">Browse events</a></div></div>}
