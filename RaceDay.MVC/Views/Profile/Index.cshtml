@model ProfileDto
@{ ViewData["Title"] = "My profile"; }
<div class="eyebrow">Your RaceDay account</div><h1 class="section-title mb-4">My profile</h1><div class="row g-4"><div class="col-lg-4"><div class="panel text-center">@if(!string.IsNullOrWhiteSpace(Model?.ProfilePictureURL)){<img src="@Model.ProfilePictureURL" alt="Profile picture" class="rounded-circle mb-3" style="width:130px;height:130px;object-fit:cover"/>}else{<div class="rounded-circle mx-auto mb-3 d-grid" style="width:130px;height:130px;place-items:center;background:#e8f1fd;color:#2358b3;font-size:2.4rem;font-weight:700">@(Model?.FirstName.FirstOrDefault())</div>}<h4 class="fw-bold">@Model?.FirstName @Model?.LastName</h4><p class="small-muted">@Model?.Email</p><span class="pill">@Model?.Role</span>
@if(Model?.Role == "Participant"){<hr/><form asp-action="UploadPicture" method="post" enctype="multipart/form-data"><label class="form-label">Update profile picture</label><input name="file" type="file" accept="image/png,image/jpeg,image/webp" class="form-control mb-2" required/><button class="btn btn-outline-success btn-sm">Upload picture</button></form>}</div></div>
<div class="col-lg-8"><div class="panel"><h4 class="fw-bold mb-3">Personal information</h4><form asp-action="Update" method="post"><div class="row"><div class="col-md-6 mb-3"><label class="form-label">First name</label><input name="FirstName" value="@Model?.FirstName" class="form-control" required/></div><div class="col-md-6 mb-3"><label class="form-label">Last name</label><input name="LastName" value="@Model?.LastName" class="form-control" required/></div></div>@if(Model?.Role == "Organiser"){<div class="mb-3"><label class="form-label">Organisation name</label><input name="OrganisationName" value="@Model.OrganisationName" class="form-control"/></div><div class="mb-3"><label class="form-label">Phone number</label><input name="PhoneNumber" value="@Model.PhoneNumber" class="form-control"/></div>}else{<div class="mb-3"><label class="form-label">Date of birth</label><input name="DateOfBirth" type="date" value="@Model?.DateOfBirth?.ToString("yyyy-MM-dd")" class="form-control"/></div>}<button class="btn btn-success">Save profile</button></form></div></div></div>
