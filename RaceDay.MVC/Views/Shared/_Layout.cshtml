@{
    var ctl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var role = Context.Session.GetString("Role");
    var signedIn = Context.Session.GetInt32("UserID") != null;
    string Active(bool on) => on ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link rel="icon" type="image/svg+xml" href="~/img/favicon.svg" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
<header class="navbar navbar-expand-lg navbar-dark raced-nav">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">R</span> RACE<span class="brand-light">DAY</span></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link @(Active(ctl == "Events" && (act == "Index" || act == "Details")))" asp-controller="Events" asp-action="Index">Events</a></li>
                @if (role == "Organiser")
                {
                    <li class="nav-item"><a class="nav-link @(Active(ctl == "Organiser"))" asp-controller="Organiser" asp-action="Dashboard">Organiser dashboard</a></li>
                    <li class="nav-item"><a class="nav-link @(Active(ctl == "Events" && (act == "Create" || act == "Edit")))" asp-controller="Events" asp-action="Create">Create event</a></li>
                }
                @if (role == "Participant")
                {
                    <li class="nav-item"><a class="nav-link @(Active(ctl == "Participant" && act == "MyEvents"))" asp-controller="Participant" asp-action="MyEvents">My events</a></li>
                    <li class="nav-item"><a class="nav-link @(Active(ctl == "Participant" && act == "MyResults"))" asp-controller="Participant" asp-action="MyResults">My results</a></li>
                }
                @if (signedIn)
                {
                    <li class="nav-item"><a class="nav-link @(Active(ctl == "Profile"))" asp-controller="Profile" asp-action="Index">My profile</a></li>
                }
            </ul>
            <div class="d-flex align-items-center gap-2">
                @if (signedIn)
                {
                    <span class="nav-user d-none d-lg-inline">@Context.Session.GetString("FullName") (@role)</span>
                    <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm">Log out</button></form>
                }
                else
                {
                    <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Log in</a>
                    <a class="btn btn-lime btn-sm" asp-controller="Account" asp-action="Register">Join RaceDay</a>
                }
            </div>
        </div>
    </div>
</header>
<main class="container py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
    }
    @RenderBody()
</main>
<footer class="footer">
    <div class="container d-flex justify-content-between flex-wrap gap-2">
        <span>RaceDay</span>
        <span>Running, walking and cycling events in South Africa</span>
    </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
